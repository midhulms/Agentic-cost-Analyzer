# Copy this file to .env and fill in what you need.
# Everything works in "mock" mode with no keys at all -- good for a first demo.

COMPLEXITY_THRESHOLD=0.55

# cheap / open-weight path
CHEAP_PROVIDER=mock          # mock | ollama | mistral
CHEAP_MODEL_NAME=llama3.1:8b
OLLAMA_BASE_URL=http://localhost:11434
MISTRAL_API_KEY=

# frontier path
FRONTIER_PROVIDER=mock       # mock | anthropic | openai
FRONTIER_MODEL_NAME=claude-sonnet-5
ANTHROPIC_API_KEY=
OPENAI_API_KEY=

DB_PATH=cost_router.db
